<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="?attr/materialCardViewOutlinedStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/text_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            app:layout_constraintEnd_toStartOf="@id/text_line_total"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Teclado" />

        <TextView
            android:id="@+id/text_line_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorPrimary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="$50.00" />

        <TextView
            android:id="@+id/text_unit_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/text_name"
            tools:text="$25.00 c/u" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_decrease"
            style="?attr/materialIconButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/action_decrease"
            app:icon="@drawable/ic_remove"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/text_unit_price" />

        <TextView
            android:id="@+id/text_quantity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="40dp"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            app:layout_constraintBottom_toBottomOf="@id/button_decrease"
            app:layout_constraintStart_toEndOf="@id/button_decrease"
            app:layout_constraintTop_toTopOf="@id/button_decrease"
            tools:text="2" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progress_updating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorSize="20dp"
            app:layout_constraintBottom_toBottomOf="@id/text_quantity"
            app:layout_constraintEnd_toEndOf="@id/text_quantity"
            app:layout_constraintStart_toStartOf="@id/text_quantity"
            app:layout_constraintTop_toTopOf="@id/text_quantity" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_increase"
            style="?attr/materialIconButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/action_increase"
            app:icon="@drawable/ic_add"
            app:layout_constraintBottom_toBottomOf="@id/button_decrease"
            app:layout_constraintStart_toEndOf="@id/text_quantity"
            app:layout_constraintTop_toTopOf="@id/button_decrease" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_remove"
            style="?attr/materialIconButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/action_remove"
            app:icon="@drawable/ic_delete"
            app:layout_constraintBottom_toBottomOf="@id/button_decrease"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/button_decrease" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
